  "_comment": "Generated by hardware/kicad/recorder/generate_pcb.py; the routing and open_items blocks are refreshed by route_pcb.py. Footprint XY for the recorder PCB; keep this file in sync with recorder.kicad_pcb. Origin is the magnet-ring (Pixelsnap) centre; +X phone right, +Y toward the camera bar. Coordinates are written verbatim into recorder.kicad_pcb, so the USB edge is y = -43. Edit both files when a part moves.",
  "board": {
    "width_mm": 64.0,
    "height_mm": 86.0,
    "thickness_mm": 0.8,
    "layers": [
      "F.Cu",
      "In1.Cu (GND)",
      "In2.Cu (VDD33)",
      "B.Cu"
    ],
    "finish": "ENIG",
    "usb_diff_ohm": null,
    "usb_signalling": "USB 2.0 full speed, 12 Mbps",
    "usb_diff_note": "Not impedance controlled, on purpose. The ESP32-S3 USB-OTG peripheral is full speed only (12 Mbps, no high-speed PHY: Espressif's USB overview table marks ESP32-S3 'USB OTG High-Speed = X'). F.Cu sits 0.1 mm above the In1 GND plane in this stackup, where a 90 ohm differential pair would need roughly 0.06 mm traces, well under the 0.127 mm any quick-turn fab will run. Rather than thicken the prepreg for a requirement the silicon does not have, D+/D- run as a tight 0.2 mm / 0.15 mm pair over solid In1 GND, under 20 mm from J2 to U1 through U7. That geometry lands near 70 ohm differential, which is electrically short at full-speed edge rates.",
    "outline_rect_mm": [
      [
        -32.0,
        -43.0
      ],
      [
        32.0,
        43.0
      ]
    ],
    "b_cu_faces_phone": true
  },
  "magnet_keepout": {
    "od_mm": 56.0,
    "id_mm": 44.0,
    "layers": [
      "User.Comments",
      "User.Eco1"
    ],
    "kind": "graphic annotation, not a DRC rule area",
    "note": "Ring is an annulus from r=22 to r=28 about the origin, below B.Cu. Every analog part (MK1, U2, U8, Y1, U6, SP1) is placed outside r=28."
  },
  "mounting_holes": {
    "drill_mm": 1.7,
    "screw": "M1.6",
    "plating": "NPTH",
    "plating_rationale": "Non-plated. The shell is aluminium in the CNC version and a steel shunt sits directly under the board, so an unplated hole removes any path for the shell to touch board copper. Switch to PTH with a GND pad only if the shell is chosen as the chassis ground return.",
