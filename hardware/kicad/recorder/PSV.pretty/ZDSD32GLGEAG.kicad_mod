(footprint "ZDSD32GLGEAG"
	(version 20260206)
	(generator "psv-hand-edit")
	(generator_version "10.0")
	(layer "F.Cu")
	(descr "SD NAND land, LGA-8, body 8.0 mm in X by 6.0-6.2 mm in Y, 1.27 mm pitch. Pads sit in two columns on the SHORT ends, 7.0 mm apart. Pads are 1.15 x 0.75 so one land covers CS CSNP*GCR01 (C = 7.0, 8 x 6.2), Zetta ZDSD*LGEAG (L = 0.80 from each end, 8 x 6.0/6.2) and MK MKDV* (D1 = 6.85, 8 x 6.0). Pin order is the vendor top view, not a microSD socket: pin 1 top-left, 1 DAT2, 2 DAT3, 3 CLK, 4 VSS down the left column, 5 CMD, 6 DAT0, 7 DAT1, 8 VDD up the right. Before 1 Nov 2026 this land was mirrored and had its columns 5.4 mm apart along the long sides, which no SD NAND matches.")
	(tags "SD NAND LGA-8 Zetta ZDSD32G")
