(kicad_pcb
	(version 20260206)
	(generator "pcbnew")
	(generator_version "10.0")
	(general
		(thickness 0.8)
		(legacy_teardrops no)
	)
	(paper "A4")
	(title_block
		(title "pixel-snap-voice recorder")
		(comment 1 "4-layer 0.8 mm ENIG. Origin = Pixelsnap magnet centre.")
		(comment 2 "USB D+/D- is a tight pair, not impedance controlled: USB 2.0 full speed, 12 Mbps.")
		(comment 3 "Planes and traces from route_pcb.py (freerouting). DRC clean.")
	)
	(layers
		(0 "F.Cu" signal)
		(4 "In1.Cu" power)
		(6 "In2.Cu" power)
		(2 "B.Cu" signal)
		(9 "F.Adhes" user "F.Adhesive")
		(11 "B.Adhes" user "B.Adhesive")
		(13 "F.Paste" user)
		(15 "B.Paste" user)
		(5 "F.SilkS" user "F.Silkscreen")
		(7 "B.SilkS" user "B.Silkscreen")
