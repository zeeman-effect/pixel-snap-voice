	(footprint "PSV:IM73A135_PG-LLGA-5-3"
		(layer "F.Cu")
		(uuid "9b6708d3-da49-48d9-8413-13a5b059b995")
		(at 30 10 90)
		(descr "Infineon IM73A135 XENSIV analog MEMS microphone, PG-LLGA-5-3 bottom port. Local copy of the KiCad 10 Sensor_Audio:Infineon_PG-LLGA-5-2 land pattern, opened up around the sound port. The library ring pad 5 leaves 0.18 mm of copper to the 0.8 mm port and its custom-pad anchor circle leaves 0.25 mm, both under this board's 0.3 mm hole clearance rule. Here the ring sits on r=0.95 mm (inner edge 0.72 mm) with its stencil aperture moved out to match, and the anchor circle is 0.32 mm so it falls wholly inside the annulus instead of poking toward the hole. Closest copper to the port is now 0.32 mm and the solder ring stays closed. https://www.infineon.com/dgdl/Infineon-IM73A135-DataSheet-v01_00-EN.pdf?fileId=8ac78c8c7f2a768a017fadec36b84500")
		(tags "MEMS Microphone LGA Dust Water")
