			(layer "In1.Cu"
				(type "copper")
				(thickness 0.017)
			)
			(layer "dielectric 2"
				(type "core")
				(thickness 0.53)
				(material "FR4")
				(epsilon_r 4.5)
				(loss_tangent 0.02)
