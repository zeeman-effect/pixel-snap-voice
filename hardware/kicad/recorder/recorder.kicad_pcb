	(paper "A4")
	(title_block
		(title "pixel-snap-voice recorder")
		(comment 1 "4-layer 0.8 mm ENIG. Origin = Pixelsnap magnet centre.")
		(comment 2 "USB D+/D- differential target 90 ohm.")
